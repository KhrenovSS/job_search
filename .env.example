# Внимание: комментарии — только отдельными строками (systemd EnvironmentFile тоже не любит инлайн).

# Мост Claude на хосте (bridge/hh_scout_bridge.py, systemd hh-scout-bridge)
BRIDGE_URL=http://127.0.0.1:8766
# = HH_BRIDGE_TOKEN из bridge/.env.bridge
BRIDGE_TOKEN=
# пусто = модель по умолчанию из моста (там BRIDGE_MODEL)
BRIDGE_MODEL=

# Досье на компанию для письма (v9.0): один веб-запрос к мосту на компанию, кэш в таблице employers.
# Идёт мимо браузера — дневной лимит загрузок не тратит, только деньги моста (~$0.2-0.3 на компанию на opus).
COMPANY_RESEARCH_ENABLED=true
# пусто = модель моста (BRIDGE_MODEL, opus); sonnet дешевле, но хуже вытаскивает зацепки с сайта
COMPANY_RESEARCH_MODEL=
# сколько дней досье считается свежим
COMPANY_RESEARCH_TTL_DAYS=180
# потолок ходов CLI в одном запросе разведки (hh, сайт, поиск по открытым источникам,
# другие вакансии этой же компании; сам лимит обращений держит prompts/company_research.md)
COMPANY_RESEARCH_MAX_TURNS=8
# таймаут одного запроса разведки; должен быть больше BRIDGE_WEB_TIMEOUT моста (900)
COMPANY_RESEARCH_TIMEOUT_S=930
# сколько компаний максимум исследовать за один прогон писем — чтобы дайджест не ждал
COMPANY_RESEARCH_MAX_PER_RUN=3

# Telegram (отдельный бот, создаётся в @BotFather)
TG_BOT_TOKEN=
# бот отвечает ТОЛЬКО этому chat_id; пусто — бот подскажет ваш id
TG_OWNER_CHAT_ID=

# Firefox владельца, запущенный с --marionette
MARIONETTE_HOST=127.0.0.1
MARIONETTE_PORT=2828
# пусто = искать geckodriver в PATH (~/.local/bin)
GECKODRIVER_PATH=
# пауза «чтения» после каждой страницы, секунды (меньше 3 с сервис не примет)
PAGE_DELAY_MIN_S=6
PAGE_DELAY_MAX_S=20
# примерно каждая N-я страница читается долго: LONG_READ_MIN_S..MAX_S секунд
LONG_READ_EVERY=6
LONG_READ_MIN_S=25
LONG_READ_MAX_S=60
# лимит загрузок страниц hh.ru за ДЕНЬ (поиск + описания, все процессы): каждый день случайное число из диапазона
DAILY_PAGE_LOADS_MIN=150
DAILY_PAGE_LOADS_MAX=200
# ритм внутри подхода: листаем BURST минут, молчим GAP минут, повторяем (диапазоны MIN-MAX)
BURST_MINUTES=7-13
GAP_MINUTES=4-9

# Расписание (Europe/Moscow)
# дайджест — каждый день в это время
DIGEST_TIME=12:00
# окна подходов: в каждом окне один сбор со случайным СТАРТОМ внутри окна; дневной лимит делится между оставшимися окнами
CRAWL_WINDOWS=07:00-10:00,12:00-15:00,18:00-22:00
# Суточная норма (общая на мгновенные отправки и дайджест 12:00): сколько лидов уходит и сколько писем
# пишется за сутки; переписка устаревших писем тоже считается
DIGEST_MAX_ITEMS=20
# Сколько ожидающих очереди перечислить в хвосте дайджеста
DIGEST_TAIL_ITEMS=8
# Через сколько дней лид выбывает из очереди, если до него не дошли
QUEUE_TTL_DAYS=30
# Потолок бонуса за ожидание в очереди (1 балл за сутки)
QUEUE_WAIT_BONUS_MAX=7
# окно свежести вакансий при поиске, дней
SEARCH_PERIOD_DAYS=2
# география: true — искать по всей России одним запросом (работа по ИП удалённая, регион заказчика не важен)
# false — вернуться к списку REGION_NAMES в config.py (49 регионов европейской части)
SEARCH_ALL_RUSSIA=true

# Хранилище (относительно корня репо, если путь не абсолютный)
DB_PATH=data/hh_scout.db
LOG_LEVEL=INFO

# --- Тонкая настройка (значения по умолчанию из config.py; менять не обязательно) ---
# порог лида и веса итогового балла (техника / роль программиста / качество лида), сумма весов = 1
SCORE_THRESHOLD=60
WEIGHT_TECH=0.55
WEIGHT_ROLE=0.25
WEIGHT_LEAD=0.20
# карточек в одной пачке триажа ИИ
TRIAGE_BATCH_SIZE=30
# страниц поиска на один запрос за проход и карточек на странице
MAX_PAGES_PER_QUERY=6
# Страниц списка своих откликов за подход (по 20 записей). Одна страница показывала только 20 свежих из 77,
# и петля обратной связи училась на обрезанной выборке (решение №48).
NEGOTIATIONS_PAGES=3
ITEMS_PER_PAGE=50
# доля бюджета подхода, которую сбор НЕ трогает — она гарантирована на загрузку страниц вакансий.
# Без неё широкий поиск съедает весь подход, описания не качаются и лидов не появляется.
DETAILS_BUDGET_SHARE=0.55
# Письмо моложе стольких суток не участвует в долях /stats и в калибровке оценщика: ответы идут до 10-го дня
# (0-1 день — 0 %, 8+ дней — 65 %), и молчание свежего письма ничего не значит.
OUTCOME_MATURE_DAYS=5
# карточки триажа с приоритетом 3, не открытые за столько дней, списываются (skipped: low_priority_expired)
LOW_PRIORITY_TTL_DAYS=3
# одна компания — один лид: другие вакансии работодателя, уже получившего лид, пропускаются столько дней (0 — всегда)
EMPLOYER_REPEAT_DAYS=90
# profi.ru — второй источник: заказы клиентов из кабинета специалиста (нужен вход на profi.ru в том же Firefox).
# Только чтение, одна загрузка ленты за подход; правила profi.ru запрещают парсинг — включайте осознанно.
PROFI_ENABLED=false
PROFI_ORDERS_URL=https://profi.ru/backoffice/n.php
# сколько страниц ленты смотреть за подход (входит в общий дневной лимит)
PROFI_PAGES_PER_RUN=1
# таймаут запроса к мосту, секунды (должен быть больше BRIDGE_TIMEOUT моста)
BRIDGE_TIMEOUT_S=180
# User-Agent для открытого справочника api.hh.ru/areas
HH_USER_AGENT=hh-scout/1.0 (you@example.com)
# каталог промптов (по умолчанию prompts/ в репо)
# PROMPTS_DIR=
# ночная резервная копия БД: каталог и сколько копий хранить
# BACKUP_DIR=data/backups
BACKUP_KEEP=7
