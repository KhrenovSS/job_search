# Shared secret; the same value goes to BRIDGE_TOKEN in the project's .env
HH_BRIDGE_TOKEN=
# Model passed to `claude --model` when the request does not override it
BRIDGE_MODEL=opus
# Таймаут веб-запросов разведки по компании (чтение страниц идёт минутами; v9.0)
BRIDGE_WEB_TIMEOUT=900
# Seconds to wait for the CLI before answering 504 (the client waits longer: 180 s)
BRIDGE_TIMEOUT=150
# Port the bridge listens on (host, all interfaces; protected by the token)
BRIDGE_PORT=8766
# Uncomment if the CLI is not logged in for the service user: value from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=
# Working directory for the CLI (must contain no CLAUDE.md); default: system temp dir
# BRIDGE_WORKDIR=
# Path to the claude executable if it is not in PATH
# CLAUDE_BIN=claude
# Корневой сертификат Минцифры для WebFetch разведки (zakupki.gov.ru и другие сайты с «российской» цепочкой TLS; v9.31).
# Node доверяет только своему набору корней — эта переменная добавляет ещё один лишь процессу моста, система не трогается.
# Путь абсолютный, к certs/russian_trusted_root_ca.pem этого репозитория.
# NODE_EXTRA_CA_CERTS=/home/<user>/projects/job_search/certs/russian_trusted_root_ca.pem
