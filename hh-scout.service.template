[Unit]
Description=HH-Scout — Telegram bot, scheduler and hh.ru browsing pipeline
After=network-online.target hh-scout-bridge.service
Wants=network-online.target
# a crash restarts the bot (it then says "🟢 запущен" itself); 5 crashes within 10 min → failed → Telegram alert via curl
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=hh-scout-alert.service

[Service]
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=@REPO@/src
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
ExecStart=@REPO@/.venv/bin/python -m hh_scout.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
